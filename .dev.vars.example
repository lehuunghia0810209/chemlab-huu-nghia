# Local Cloudflare Pages Functions only — never put a real key in Git.
# Copy this file to .dev.vars, then replace the placeholder locally.
# CHEMAI_PROVIDER picks one provider: unset or groq = Groq, gemini = Gemini, anything else = off.
# No automatic fallback between providers.
CHEMAI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Optional token limits (defaults: 4096 output incl. reasoning, 3600 estimated input)
# GROQ_MAX_COMPLETION_TOKENS=4096
# CHEMAI_MAX_INPUT_TOKENS=3600

# Public (anonymous) mode. CHEMAI_ACCESS_MODE=public alone opens nothing: it also needs
# CHEMAI_PUBLIC_APPROVAL="<provider>:<release>" (owner's record that the provider's terms
# allow the real audience, for that exact release), CHEMAI_PUBLIC_HOSTS and the CHEMAI_BUDGET
# Durable Object binding. Leave unset until an approved release.
# CHEMAI_PUBLIC_APPROVAL=
# CHEMAI_PUBLIC_HOSTS=
# CHEMAI_PUBLIC_DAILY_LIMIT_PER_CLIENT=5
# CHEMAI_PUBLIC_COOLDOWN_SECONDS=10
# CHEMAI_PUBLIC_REQUESTS_PER_MINUTE=20
# CHEMAI_DAILY_LIMIT=200

# Gemini (kept, used only with CHEMAI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low

# ChemAI access gate (6.5.4). Missing/unknown mode = disabled. student_access is refused in code.
# CHEMAI_ACCESS_MODE=disabled
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD tag>
# CHEMAI_APPROVED_EMAILS=teacher@example.org
# CHEMAI_INTERNAL_HOSTS=<preview host only, never the production host>
