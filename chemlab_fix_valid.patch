     justify-items: start;
   }
 
-}
\ No newline at end of file
+}
+/* =========================================================
+   GUIDED LAB RESULT CONFIRMATION
+========================================================= */
+
+.guided-lab-confirmation {
+  display: grid;
+  grid-template-columns: minmax(0,1fr) auto;
+  align-items: center;
+  gap: 16px;
+  margin-top: 16px;
+  padding: 16px;
+  border: 1px solid rgba(96,165,250,.2);
+  border-radius: 16px;
+  background:
+    linear-gradient(135deg,rgba(59,130,246,.09),rgba(124,58,237,.07));
+}
+
+.guided-lab-confirmation strong {
+  display: block;
+  margin-top: 6px;
+  color: #eef4ff;
+  line-height: 1.45;
+}
+
+.guided-lab-confirmation p {
+  margin: 7px 0 0;
+  color: #a8b4ca;
+  line-height: 1.55;
+}
+
+.guided-lab-confirmation .guided-primary-btn {
+  min-width: 210px;
+  white-space: normal;
+}
+
+html[data-theme="light"] .guided-lab-confirmation {
+  border-color: rgba(64,89,145,.14);
+  background:
+    linear-gradient(135deg,rgba(227,237,255,.92),rgba(241,235,255,.88));
+}
+
+html[data-theme="light"] .guided-lab-confirmation strong {
+  color: #27324a;
+}
+
+html[data-theme="light"] .guided-lab-confirmation p {
+  color: #647087;
+}
+
+@media (max-width: 767px) {
+  .guided-lab-confirmation {
+    grid-template-columns: 1fr;
+    gap: 12px;
+    padding: 14px;
+  }
+
+  .guided-lab-confirmation .guided-primary-btn {
+    width: 100%;
+    min-width: 0;
+  }
+}
