+}
+/* =========================================================
+   SOAP FOAM + PURPLE LITMUS PAPER
+========================================================= */
+
+.foam-layer {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 4;
+  pointer-events: none;
+  overflow: visible;
+}
+
+.foam-layer i {
+  position: absolute;
+  display: block;
+  border: 1px solid rgba(255,255,255,.82);
+  border-radius: 50%;
+  background: rgba(246,251,255,.62);
+  box-shadow:
+    inset 0 0 8px rgba(255,255,255,.75),
+    0 0 8px rgba(208,232,255,.2);
+  opacity: 0;
+  animation: soapFoamIn .6s ease-out forwards;
+}
+
+.foam-layer.active {
+  filter: drop-shadow(0 3px 8px rgba(213,235,255,.12));
+}
+
+@keyframes soapFoamIn {
+  from {
+    transform: translateY(8px) scale(.65);
+    opacity: 0;
+  }
+
+  to {
+    transform: translateY(0) scale(1);
+    opacity: .95;
+  }
+}
+
+.litmus-paper-result {
+  display: inline-grid;
+  grid-template-columns: 12px minmax(0,1fr);
+  align-items: center;
+  gap: 9px;
+  max-width: 100%;
+  margin-bottom: 10px;
+  padding: 7px 10px;
+  border: 1px solid rgba(155,166,196,.18);
+  border-radius: 10px;
+  background: rgba(8,12,22,.78);
+  backdrop-filter: blur(10px);
+}
+
+.litmus-paper-result[hidden] {
+  display: none;
+}
+
+.litmus-paper-strip {
+  display: block;
+  width: 9px;
+  height: 34px;
+  margin: 0;
+  border-radius: 3px;
+  background: var(--litmus-color,#806bb0);
+  box-shadow:
+    0 0 0 1px rgba(255,255,255,.24),
+    0 0 12px color-mix(in srgb, var(--litmus-color,#806bb0) 42%, transparent);
+  transform: rotate(4deg);
+  transition: background .25s ease, box-shadow .25s ease;
+}
+
+.stage-note .litmus-paper-result span {
+  display: block;
+  margin: 0;
+  color: #d9e2f3;
+  font-size: .75rem;
+  line-height: 1.35;
+  font-weight: 750;
+}
+
+html[data-theme="light"] .litmus-paper-result {
+  border-color: rgba(58,68,92,.12);
+  background: rgba(250,252,255,.9);
+}
+
+html[data-theme="light"] .stage-note .litmus-paper-result span {
+  color: #354057;
+}
+
+@media (max-width: 767px) {
+  .litmus-paper-result {
+    grid-template-columns: 10px minmax(0,1fr);
+    gap: 7px;
+    padding: 6px 8px;
+  }
+
+  .litmus-paper-strip {
+    width: 8px;
+    height: 28px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .foam-layer i {
+    animation: none;
+    opacity: .95;
+  }
+}
